# Kisan Mitra — environment variables
# Copy to .env and fill in your own keys. Never commit .env.

# LLM (Phase 2 chat) — SambaNova default
LLM_PROVIDER=sambanova
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# If the primary provider fails (rate limit, outage, etc), try these next, in order.
# Comma-separated provider names. Leave empty to disable fallback.
LLM_FALLBACK_PROVIDERS=sambanova,huggingface,gemini,openai,anthropic

# Optional alternate LLM providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Bhashini voice (Phase 3) — optional if using MLX STT
VOICE_STT_PROVIDER=mlx
# mlx = local Qwen2-Audio on Apple Silicon | bhashini = cloud | auto = mlx then bhashini
MLX_STT_ENABLED=1
MLX_STT_MODEL=mlx-community/Qwen2-Audio-7B-Instruct-4bit
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# AWS: login (Cognito) and data (DynamoDB). Created by infra/ Terraform; fill these with
#   cd infra && terraform output -raw backend_env
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_PREFIX=kisan-mitra-dev
COGNITO_FARMER_POOL_ID=
COGNITO_FARMER_CLIENT_ID=
COGNITO_FARMER_CLIENT_SECRET=
COGNITO_ADMIN_POOL_ID=
COGNITO_ADMIN_CLIENT_ID=
COGNITO_ADMIN_CLIENT_SECRET=
# Phone numbers allowed to log in (comma-separated country prefixes)
ALLOWED_PHONE_PREFIXES=+91

# Phase 1 disease model
# A directory (loads the models listed in model_meta.json, or every *.tflite)
# or a single .tflite file. Input size is read from the model itself.
MODEL_PATH=backend/models
MODEL_PREPROCESS=none
# Average each prediction over the image and its horizontal flip
MODEL_TTA=1
# Leave unset to use the threshold calibrated by the v3 notebook (model_meta.json)
# CONFIDENCE_THRESHOLD=60.0
MAX_IMAGE_SIZE_MB=10
PORT=8000
