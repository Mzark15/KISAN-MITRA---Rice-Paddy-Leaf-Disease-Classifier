# Kisan Mitra — environment variables
# Copy to .env and fill in your own keys. Never commit .env.

# LLM (Phase 2 chat) — SambaNova default
LLM_PROVIDER=sambanova
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Optional alternate LLM providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bhashini voice (Phase 3) — optional if using MLX STT
VOICE_STT_PROVIDER=mlx
# mlx = local Qwen2-Audio on Apple Silicon | bhashini = cloud | auto = mlx then bhashini
MLX_STT_ENABLED=1
MLX_STT_MODEL=mlx-community/Qwen2-Audio-7B-Instruct-4bit
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Database (Phase 4 dashboard)
DB_PATH=data/kisan_mitra.db

# Dashboard
DASHBOARD_PASSWORD=kisan123

# Phase 1 disease model
MODEL_PATH=backend/models/paddy_disease_model.tflite
MODEL_INPUT_SIZE=224
MODEL_PREPROCESS=none
CONFIDENCE_THRESHOLD=60.0
MAX_IMAGE_SIZE_MB=10
PORT=8000
