<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for navigator.mediaDevices.getUserMedia() in the WebView
         (Voice Chat's microphone). Without this, mediaDevices is undefined
         even on a secure origin — this is a separate, manifest-level gate
         from the JS secure-context requirement. Capacitor's bridge already
         handles the runtime permission prompt/grant once this is declared. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Chromium's audio capture stack inside the WebView explicitly requires
         this alongside RECORD_AUDIO — confirmed via Logcat tag "cr_media":
         "Requires MODIFY_AUDIO_SETTINGS and RECORD_AUDIO. No audio device
         will be available for recording." It's a "normal" permission (no
         runtime prompt) but still must be declared here or it's silently
         absent, which is what was actually causing getUserMedia's
         NotAllowedError this whole time — not a permission cache issue. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Not strictly required today (camera capture uses a system intent via
         <input capture>, not getUserMedia), but harmless to have ready in
         case that changes later. -->
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>
